generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
model Restaurant {
 id String @id @default(cuid())
 name String
 threshold Int @default(300)
 tables DiningTable[]
 cameras Camera[]
 events VisionEvent[]
 outbox Outbox[]
}
model DiningTable {
 id String @id
 restaurantId String
 restaurant Restaurant @relation(fields:[restaurantId],references:[id])
 name String
 zone String
 capacity Int @default(4)
 people Int @default(0)
 state String @default("FREE")
 occupiedAt DateTime?
 servedAt DateTime?
 updatedAt DateTime @default(now())
 @@index([restaurantId])
}
model Camera {
 id String @id @default(cuid())
 restaurantId String
 restaurant Restaurant @relation(fields:[restaurantId],references:[id])
 name String
 sourceType String @default("MP4")
 zones Json @default("[]")
 lastSeen DateTime?
}
model VisionEvent {
 id String @id
 restaurantId String
 restaurant Restaurant @relation(fields:[restaurantId],references:[id])
 tableId String
 type String
 people Int
 source String
 occurredAt DateTime
 createdAt DateTime @default(now())
 @@index([restaurantId,occurredAt])
}
model Outbox {
 id String @id
 restaurantId String
 restaurant Restaurant @relation(fields:[restaurantId],references:[id])
 payload Json
 attempts Int @default(0)
 deliveredAt DateTime?
 createdAt DateTime @default(now())
 @@index([restaurantId,deliveredAt])
}
